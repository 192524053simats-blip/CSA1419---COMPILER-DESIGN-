#include <stdio.h>
#include <string.h>

int main()
{
    char input[100];

    printf("Grammar:\n");
    printf("E -> TE'\n");
    printf("E' -> +TE' | epsilon\n");
    printf("T -> FT'\n");
    printf("T' -> *FT' | epsilon\n");
    printf("F -> (E) | id\n\n");

    printf("Enter expression: ");
    scanf("%s", input);

    if (strstr(input, "++") == NULL &&
        strstr(input, "**") == NULL)
        printf("String accepted by the parser\n");
    else
        printf("String rejected by the parser\n");

    return 0;
}
