#include <stdio.h>

int main()
{
    char result, op1, op2, op;

    printf("Enter three address statement (example: t1=a+b): ");
    scanf(" %c = %c %c %c",
          &result, &op1, &op, &op2);

    printf("\nTarget Code:\n");
    printf("MOV R0, %c\n", op1);

    if (op == '+')
        printf("ADD R0, %c\n", op2);
    else if (op == '-')
        printf("SUB R0, %c\n", op2);
    else if (op == '*')
        printf("MUL R0, %c\n", op2);
    else if (op == '/')
        printf("DIV R0, %c\n", op2);
    else
    {
        printf("Invalid operator\n");
        return 0;
    }

    printf("MOV %c, R0\n", result);

    return 0;
}
