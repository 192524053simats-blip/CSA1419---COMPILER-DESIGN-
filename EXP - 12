#include <stdio.h>
#include <ctype.h>

char input[100];
int pos = 0;
int error = 0;

void E();
void T();
void F();

void E()
{
    T();

    while (input[pos] == '+')
    {
        pos++;
        T();
    }
}

void T()
{
    F();

    while (input[pos] == '*')
    {
        pos++;
        F();
    }
}

void F()
{
    if (input[pos] == '(')
    {
        pos++;
        E();

        if (input[pos] == ')')
            pos++;
        else
            error = 1;
    }
    else if (isalpha(input[pos]))
    {
        pos++;
    }
    else
    {
        error = 1;
    }
}

int main()
{
    printf("Enter expression: ");
    scanf("%s", input);

    E();

    if (input[pos] != '\0')
        error = 1;

    if (error)
        printf("Invalid expression\n");
    else
        printf("Valid expression\n");

    return 0;
}
